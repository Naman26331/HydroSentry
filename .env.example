# HydroSentry runtime configuration.  Copy to ".env" (same folder) and edit.
# NEVER put AWS keys in this file's committed copy; .env is git-ignored.

ENVIRONMENT=LOCAL                       # LOCAL = emulator / sam local, AWS = real cloud
AWS_REGION=ap-south-1
DYNAMODB_TABLE_NAME=HydroSentry-HazardState
EVENT_BUS_NAME=HydroSentry-EventBus

# LOCAL: http://127.0.0.1:3000 (sam local start-api)
# AWS:   your API Gateway URL, e.g. https://abc123.execute-api.ap-south-1.amazonaws.com
API_GATEWAY_URL=http://127.0.0.1:3000

# LOCAL emulator only (Lambda containers reach the host through this name)
AWS_ENDPOINT_URL=http://host.docker.internal:4566

# Credentials: prefer `aws configure`. Only for temporary Learner Lab / Builder Center keys:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
